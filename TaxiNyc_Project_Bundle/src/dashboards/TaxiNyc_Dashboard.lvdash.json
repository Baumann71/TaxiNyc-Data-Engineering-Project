{
  "datasets": [
    {
      "name": "969e32dd",
      "displayName": "fact_trips",
      "queryLines": [
        "select *\r\n",
        "from taxis_project_dev.silver.fact_trips\r\n",
        "where (pickup_latitude between 40.5 and 40.9) and\r\n",
        "(pickup_longitude between -74.3 and -73.7) and\r\n",
        "(dropoff_latitude between 40.5 and 40.9) and\r\n",
        "(dropoff_longitude between -74.3 and -73.7)"
      ]
    },
    {
      "name": "488a9db4",
      "displayName": "Vendor Trip Counts Overview",
      "queryLines": [
        "select v.vendor_description, count(*) as total_trips\r\n",
        "from taxis_project_dev.silver.fact_trips t\r\n",
        "join taxis_project_dev.silver.dim_vendor v on t.vendor_id = v.vendor_id\r\n",
        "group by v.vendor_id, v.vendor_description"
      ]
    },
    {
      "name": "e250cf03",
      "displayName": "Taxi Trip Counts by Payment Method",
      "queryLines": [
        "select p.payment_description, count(*) as total_trips\r\n",
        "from taxis_project_dev.silver.fact_trips t\r\n",
        "join taxis_project_dev.silver.dim_paymenttype p on t.paymenttype_id = p.paymenttype_id\r\n",
        "group by p.paymenttype_id, p.payment_description"
      ]
    },
    {
      "name": "5614837e",
      "displayName": "medidas",
      "queryLines": [
        "select round(sum(total_amount),2), \r\n",
        "    round(avg(trip_distance_km),2), \r\n",
        "    round(avg(tip_amount),2), \r\n",
        "    round(avg(tolls_amount),2), \r\n",
        "    round(avg(total_amount),2), \r\n",
        "    count(*) as total_trips\r\n",
        "from taxis_project_dev.silver.fact_trips t\r\n"
      ]
    },
    {
      "name": "13611708",
      "displayName": "horas con mas viajes",
      "queryLines": [
        "select ti.hour, \r\n",
        " round(count(*)*100.0/(select COUNT(*) from taxis_project_dev.silver.fact_trips),2) as perc_trips_per_hour\r\n",
        "from taxis_project_dev.silver.fact_trips tr\r\n",
        "join taxis_project_dev.silver.dim_time ti on tr.pickup_time_id = ti.time_id\r\n",
        "group by ti.hour"
      ]
    }
  ],
